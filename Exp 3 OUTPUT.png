		<script>
			(function(){
				let replace_url = function(text){
					let url = window.location.href;
					let title = document.title;
					let url_text = title + ': ' + url;
					return text
						.replace("URL_ENCODED", encodeURIComponent(url))
						.replace("TITLE_ENCODED", encodeURIComponent(title))
						.replace("URL_TEXT_ENCODED", encodeURIComponent(url_text));
				};
				$(document).ready(function(){
					$(".social-widgets a").each(function(){
						$(this).attr("href", replace_url($(this).attr("href")));
					});
				});
			})();
		</script>


		<script src="./Exp 3 OUTPUT_files/jquery-ui.min.js.download"></script>
<script src="./Exp 3 OUTPUT_files/jqimg.js.download"></script>
<script src="./Exp 3 OUTPUT_files/spectrum.js.download"></script>
<script src="./Exp 3 OUTPUT_files/myColorPicker.js.download"></script>
