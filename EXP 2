#include <stdio.h>
void create(int arr[], int n);
void display(int arr[], int n);
void search(int arr[], int n);
int main()
{
int arr[100], n, choice;
printf("Enter the number of elements: ");
scanf("%d", &n);
create(arr, n);
while(1)
{
printf("\n\n--- MENU ---");
printf("\n1. Display");
printf("\n2. Binary Search");
printf("\n3. Exit");
printf("\nEnter your choice: ");
scanf("%d", &choice);
switch(choice)
{
case 1:
display(arr, n);
break;
case 2:
search(arr, n);
break;
case 3:
printf("Exiting program...");
return 0;
default:
printf("Invalid choice!");
}

}
return 0;
}
void create(int arr[], int n)
{
int i;
printf("Enter %d elements:\n", n);
for(i = 0; i < n; i++)
{
scanf("%d", &arr[i]);
}
}
void display(int arr[], int n)
{
int i;
printf("\nArray elements are:\n");
for(i = 0; i < n; i++)
{
printf("%d ", arr[i]);
}
printf("\n");
}
void search(int arr[], int n)
{
int i, j, temp;
int key;
int low, high, mid;
int found = 0;
/* Sorting the array */
for(i = 0; i < n - 1; i++)
{
for(j = 0; j < n - i - 1; j++)
{
if(arr[j] > arr[j + 1])
{
temp = arr[j];
arr[j] = arr[j + 1];
arr[j + 1] = temp;
}
}
}

printf("\nSorted array is:\n");
for(i = 0; i < n; i++)
{
printf("%d ", arr[i]);
}
printf("\n\nEnter the element to search: ");
scanf("%d", &key);
/* Binary Search using while loop */
low = 0;
high = n - 1;
while(low <= high)
{
mid = (low + high) / 2;
if(arr[mid] == key)
{
printf("Element found at position %d\n", mid + 1);
found = 1;
break;
}
else if(key < arr[mid])
{
high = mid - 1;
}
else
{
low = mid + 1;
}
}
if(found == 0)
{
printf("Element not found\n");
}
}
